
#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
#include <limits>

using namespace std;

// Represents one monthly subscription.
class Subscription {
private:
    string name;
    double monthlyCost;
    string dueDate;

public:
    // Initializes a subscription with its details.
    Subscription(string subscriptionName, double cost, string billingDate) {
        name = subscriptionName;
        monthlyCost = cost;
        dueDate = billingDate;
    }

    // Returns the subscription name.
    string GetName() const {
        return name;
    }

    // Returns the monthly subscription cost.
    double GetMonthlyCost() const {
        return monthlyCost;
    }

    // Returns the billing date.
    string GetDueDate() const {
        return dueDate;
    }
};

// Manages the user's subscription collection.
class SubscriptionTracker {
private:
    vector<Subscription> subscriptions;

    // Reads a valid menu choice.
    int GetIntegerInput() {
        int value;

        while (!(cin >> value)) {
            cout << "Invalid input. Enter a whole number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return value;
    }

    // Displays the available program options.
    void DisplayMenu() const {
        cout << "\n===== MONTHLY SUBSCRIPTION TRACKER =====\n";
        cout << "1. Add a subscription\n";
        cout << "2. View all subscriptions\n";
        cout << "3. View monthly and yearly totals\n";
        cout << "4. Remove a subscription\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
    }

public:
    // Collects information and adds a subscription.
    void AddSubscription() {
        string name;
        string dueDate;
        double monthlyCost;

        cout << "\nEnter subscription name: ";
        getline(cin, name);

        while (name.find_first_not_of(" \t") == string::npos) {
            cout << "Name cannot be empty. Enter a name: ";
            getline(cin, name);
        }

        cout << "Enter monthly cost ($): ";

        while (!(cin >> monthlyCost) ||
               monthlyCost < 0) {
            cout << "Enter a valid nonnegative cost: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        cout << "Enter billing date: ";
        getline(cin, dueDate);

        if (dueDate.find_first_not_of(" \t") == string::npos) {
            dueDate = "Not specified";
        }

        // Create and store the new subscription.
        subscriptions.emplace_back(name, monthlyCost, dueDate);

        cout << "Subscription added successfully!\n";
    }

    // Displays all saved subscriptions.
    void ViewSubscriptions() const {
        if (subscriptions.empty()) {
            cout << "\nNo subscriptions have been added yet.\n";
            return;
        }

        cout << fixed << setprecision(2);
        cout << "\n========== YOUR SUBSCRIPTIONS ==========\n";

        for (size_t i = 0; i < subscriptions.size(); i++) {
            cout << "\nSubscription #" << i + 1 << '\n';
            cout << "Name: " << subscriptions[i].GetName() << '\n';
            cout << "Monthly cost: $"
                 << subscriptions[i].GetMonthlyCost() << '\n';
            cout << "Billing date: "
                 << subscriptions[i].GetDueDate() << '\n';
        }
    }

    // Calculates the total monthly cost.
    double CalculateMonthlyTotal() const {
        double total = 0.0;

        for (const Subscription& subscription : subscriptions) {
            total += subscription.GetMonthlyCost();
        }

        return total;
    }

    // Displays monthly and estimated yearly expenses.
    void DisplayYearlyTotal() const {
        double monthlyTotal = CalculateMonthlyTotal();
        double yearlyTotal = monthlyTotal * 12;

        cout << fixed << setprecision(2);
        cout << "\nTotal monthly cost: $" << monthlyTotal << '\n';
        cout << "Estimated yearly cost: $" << yearlyTotal << '\n';
    }

    // Removes a subscription selected by its number.
    void RemoveSubscription() {
        if (subscriptions.empty()) {
            cout << "\nThere are no subscriptions to remove.\n";
            return;
        }

        ViewSubscriptions();

        cout << "\nEnter the subscription number to remove: ";
        int number = GetIntegerInput();

        while (number < 1 ||
               number > static_cast<int>(subscriptions.size())) {
            cout << "Invalid selection. Enter a number from 1 to "
                 << subscriptions.size() << ": ";
            number = GetIntegerInput();
        }

        subscriptions.erase(subscriptions.begin() + number - 1);
        cout << "Subscription removed successfully!\n";
    }

    // Runs the program until the user chooses to exit.
    void Run() {
        int choice = 0;

        do {
            DisplayMenu();
            choice = GetIntegerInput();

            switch (choice) {
                case 1:
                    AddSubscription();
                    break;

                case 2:
                    ViewSubscriptions();
                    break;

                case 3:
                    DisplayYearlyTotal();
                    break;

                case 4:
                    RemoveSubscription();
                    break;

                case 5:
                    cout << "Thank you for using the tracker!\n";
                    break;

                default:
                    cout << "Invalid choice. Select 1 through 5.\n";
            }

        } while (choice != 5);
    }
};

// Starts the application.
int main() {
    SubscriptionTracker tracker;
    tracker.Run();

    return 0;
}
